diff --git a/oxifoc-f405/.cargo/config.toml b/oxifoc-f405/.cargo/config.toml
index 80657b3..af941b4 100644
--- a/oxifoc-f405/.cargo/config.toml
+++ b/oxifoc-f405/.cargo/config.toml
@@ -9,5 +9,2 @@ runner = ["bash", "../scripts/probe_run_f405.sh"]
-# DO NOT REMOVE these target features:
-#  +vfp2  — required by the `sreg` register class in oxifoc-core's q31 inline asm
-#  -fp64  — without it LLVM emits double-precision FPU instructions the
-#           FPv4-SP-D16 FPU doesn't support, and the board hangs at runtime
-rustflags = ["-C", "target-feature=+vfp2,-fp64"]
+# Cortex-M4F: hardware single-precision FP, including q31 vcvt asm.
+rustflags = ["-C", "target-feature=+vfp2sp"]
