import { VerticalBox, HorizontalBox, Button, ComboBox, Slider, CheckBox, SpinBox,
         StandardListView, LineEdit, GroupBox, ScrollView, GridBox, ListView, Palette } from "std-widgets.slint";
import { PlotWidget } from "@slint-wgpu-plot/plot.slint";

export struct LogMessage {
    text: string,
    level: int, // 0=trace, 1=debug, 2=info, 3=warn, 4=error
}

export component App inherits Window {
    title: "Oxifoc Host";
    preferred-width: 900px;
    preferred-height: 750px;

    // ── Page state ──
    in-out property <string> page: "connect";

    // ── Connection properties ──
    // transport-mode: 0=Serial, 1=RTT, 2=TCP, 3=UDP, 4=USB
    in-out property <int> transport-mode: 0;
    in property <[StandardListViewItem]> serial-ports;
    in property <[StandardListViewItem]> probes;
    in-out property <int> selected-serial: -1;
    in-out property <int> selected-probe: -1;
    in-out property <int> baud-index: 3;
    in-out property <string> chip-name: "STM32G474RETx";
    in-out property <bool> usb-only: true;
    in-out property <string> tcp-host: "127.0.0.1";
    in-out property <string> tcp-port: "2025";
    in-out property <string> udp-host: "127.0.0.1";
    in-out property <string> udp-port: "2025";
    in property <string> error-text: "";

    // ── Main page state ──
    in property <bool> is-connected: false;

    // ── Device info (set once on connection) ──
    in property <string> device-hw: "";
    in property <string> device-sw: "";
    in property <string> device-mcu: "";
    in property <string> device-uuid: "";
    in property <int> device-foc-hz: 0;
    in property <float> device-max-current: 0;

    // ── Motor control ──
    in-out property <float> duty: 10;
    in-out property <int> pole-pairs: 7;

    // ── Telemetry (formatted strings from Rust) ──
    in property <string> ia-text:   "0";
    in property <string> ib-text:   "0";
    in property <string> ic-text:   "0";
    in property <string> vbus-text: "0.00 V";
    in property <string> temp-text: "0.0 °C";
    in property <string> erpm-text: "0";
    in property <string> rpm-text:  "0";
    in property <string> seq-text:  "0";

    // ── Chart textures and auto-range (set by Rust after each render) ──
    in property <image> currents-texture;
    in property <image> vbus-texture;
    in property <image> temp-texture;
    in property <float> currents-y-min: -1.0;
    in property <float> currents-y-max: 1.0;
    in property <float> vbus-y-min: 0.0;
    in property <float> vbus-y-max: 60.0;
    in property <float> temp-y-min: 0.0;
    in property <float> temp-y-max: 150.0;

    // ── Chart size feedback ──
    out property <length> currents-w: currents-plot.requested-texture-width;
    out property <length> currents-h: currents-plot.requested-texture-height;
    out property <length> vbus-w:     vbus-plot.requested-texture-width;
    out property <length> vbus-h:     vbus-plot.requested-texture-height;
    out property <length> temp-w:     temp-plot.requested-texture-width;
    out property <length> temp-h:     temp-plot.requested-texture-height;

    // ── Chart pan/zoom state (read by Rust) ──
    out property <bool> currents-paused: currents-plot.paused;
    out property <int> currents-view-offset: currents-plot.view-offset;
    out property <float> currents-time-window: currents-plot.time-window;
    out property <bool> vbus-paused: vbus-plot.paused;
    out property <int> vbus-view-offset: vbus-plot.view-offset;
    out property <float> vbus-time-window: vbus-plot.time-window;
    out property <bool> temp-paused: temp-plot.paused;
    out property <int> temp-view-offset: temp-plot.view-offset;
    out property <float> temp-time-window: temp-plot.time-window;

    // ── Sample rate for plots (set by Rust from actual_fast_hz) ──
    in property <float> fast-sample-rate: 1000.0;

    // ── Log panel ──
    in property <[LogMessage]> log-messages;
    callback clear-log();

    // ── Motor presets ──
    in property <[string]> preset-names;
    in-out property <int> selected-preset: 0;
    callback preset-changed(string);

    // ── Callbacks ──
    callback refresh-serial-ports();
    callback refresh-probes();
    callback connect-device();
    callback disconnect-device();
    callback motor-start();
    callback motor-stop();

    // ═══════════════════════════════════════════
    //  Connection Page
    // ═══════════════════════════════════════════
    connect-page := VerticalLayout {
        visible: root.page == "connect";
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "Connect to Device";
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // ── Transport selector ──
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Button {
                text: "Serial";
                primary: root.transport-mode == 0;
                clicked => { root.transport-mode = 0; }
            }
            Button {
                text: "RTT";
                primary: root.transport-mode == 1;
                clicked => { root.transport-mode = 1; }
            }
            Button {
                text: "TCP";
                primary: root.transport-mode == 2;
                clicked => { root.transport-mode = 2; }
            }
            Button {
                text: "UDP";
                primary: root.transport-mode == 3;
                clicked => { root.transport-mode = 3; }
            }
            Button {
                text: "USB";
                primary: root.transport-mode == 4;
                clicked => { root.transport-mode = 4; }
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: #ef4444;
            horizontal-alignment: center;
        }

        // ── Serial config ──
        if root.transport-mode == 0 : VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Serial Ports";
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                CheckBox {
                    text: "USB-Serial only";
                    checked <=> root.usb-only;
                    toggled => { root.refresh-serial-ports(); }
                }
                Button {
                    text: "Refresh";
                    clicked => { root.refresh-serial-ports(); }
                }
            }

            StandardListView {
                model: root.serial-ports;
                current-item <=> root.selected-serial;
                min-height: 160px;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text { text: "Baud Rate:"; vertical-alignment: center; }
                ComboBox {
                    model: ["115200", "230400", "460800", "921600", "1000000", "2000000"];
                    current-index <=> root.baud-index;
                    width: 150px;
                }
            }
        }

        // ── RTT config ──
        if root.transport-mode == 1 : VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Debug Probes";
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Button {
                    text: "Refresh";
                    clicked => { root.refresh-probes(); }
                }
            }

            StandardListView {
                model: root.probes;
                current-item <=> root.selected-probe;
                min-height: 160px;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text { text: "Target Chip:"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.chip-name;
                    width: 220px;
                }
            }
        }

        // ── TCP config ──
        if root.transport-mode == 2 : VerticalLayout {
            spacing: 8px;

            Text {
                text: "TCP Connection";
                font-size: 16px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text { text: "Host:"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.tcp-host;
                    width: 200px;
                }
                Text { text: "Port:"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.tcp-port;
                    width: 80px;
                }
            }
        }

        // ── UDP config ──
        if root.transport-mode == 3 : VerticalLayout {
            spacing: 8px;

            Text {
                text: "UDP Connection";
                font-size: 16px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text { text: "Host:"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.udp-host;
                    width: 200px;
                }
                Text { text: "Port:"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.udp-port;
                    width: 80px;
                }
            }
        }

        // ── USB config ──
        if root.transport-mode == 4 : VerticalLayout {
            spacing: 8px;

            Rectangle {
                background: #f0f0f5;
                border-radius: 4px;
                min-height: 60px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "USB (Auto-detect)";
                        font-size: 15px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Connects to the first ergot USB device found";
                        horizontal-alignment: center;
                        color: #555;
                    }
                }
            }
        }

        // ── Connect button ──
        HorizontalLayout {
            alignment: center;

            Button {
                text: "Connect";
                primary: true;
                enabled: root.transport-mode == 0 ? root.selected-serial >= 0
                       : root.transport-mode == 1 ? (root.selected-probe >= 0 && root.chip-name != "")
                       : root.transport-mode == 2 ? (root.tcp-host != "" && root.tcp-port != "")
                       : root.transport-mode == 3 ? (root.udp-host != "" && root.udp-port != "")
                       : true; // USB always enabled
                clicked => { root.connect-device(); }
            }
        }
    }

    // ═══════════════════════════════════════════
    //  Main Page
    // ═══════════════════════════════════════════
    main-page := VerticalLayout {
        visible: root.page == "main";
        padding: 12px;
        spacing: 8px;

        // ── Status bar ──
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.is-connected ? #22c55e : #eab308;
            }
            Text {
                text: root.is-connected
                    ? root.device-hw != "" ? "\{root.device-hw} (\{root.device-mcu})" : "Connected"
                    : "Connecting...";
                vertical-alignment: center;
            }
            if root.device-sw != "" : Text {
                text: root.device-sw;
                vertical-alignment: center;
                color: Palette.foreground;
                opacity: 0.6;
                font-size: 11px;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Disconnect";
                clicked => { root.disconnect-device(); }
            }
        }

        // ── Motor preset + pole pairs ──
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text { text: "Motor:"; vertical-alignment: center; }
            ComboBox {
                model: root.preset-names;
                current-index <=> root.selected-preset;
                selected(idx) => { root.preset-changed(idx); }
                min-width: 200px;
            }
            Text { text: "Pole pairs:"; vertical-alignment: center; }
            SpinBox {
                minimum: 1;
                maximum: 50;
                value <=> root.pole-pairs;
                min-width: 80px;
            }
        }

        // ── Motor control ──
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text { text: "Duty (%)"; vertical-alignment: center; }
            Slider {
                minimum: 0;
                maximum: 100;
                value <=> root.duty;
                min-width: 120px;
            }
            Text {
                text: "\{round(root.duty)}%";
                vertical-alignment: center;
                min-width: 35px;
            }
            Button {
                text: "Start";
                primary: true;
                clicked => { root.motor-start(); }
            }
            Button {
                text: "Stop";
                clicked => { root.motor-stop(); }
            }
        }

        // ── Telemetry ──
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 4px;
            min-height: 60px;

            GridLayout {
                padding: 10px;
                spacing: 6px;

                Row {
                    Text { text: "Phase A:"; }
                    Text { text: root.ia-text;   font-weight: 600; }
                    Text { text: "Phase B:"; }
                    Text { text: root.ib-text;   font-weight: 600; }
                    Text { text: "Phase C:"; }
                    Text { text: root.ic-text;   font-weight: 600; }
                }
                Row {
                    Text { text: "ERPM:"; }
                    Text { text: root.erpm-text; font-weight: 600; }
                    Text { text: "RPM:"; }
                    Text { text: root.rpm-text;  font-weight: 600; }
                    Text { text: "Pole pairs:"; }
                    Text { text: root.pole-pairs; font-weight: 600; }
                }
                Row {
                    Text { text: "VBUS:"; }
                    Text { text: root.vbus-text; font-weight: 600; }
                    Text { text: "Temp:"; }
                    Text { text: root.temp-text; font-weight: 600; }
                    Text { text: "Seq:"; }
                    Text { text: root.seq-text;  font-weight: 600; }
                }
            }
        }

        // ── Charts ──
        currents-plot := PlotWidget {
            vertical-stretch: 2;
            title: "Phase Currents (A)";
            texture: root.currents-texture;
            y-min: root.currents-y-min;
            y-max: root.currents-y-max;
            y-divisions: 4;
            time-window: 2.0;
            x-divisions: 5;
            sample-rate: root.fast-sample-rate;
            legend-labels: ["Phase A", "Phase B", "Phase C"];
            legend-colors: [#22d3ee, #8b5cf6, #f97316];
        }

        vbus-plot := PlotWidget {
            vertical-stretch: 1;
            title: "Bus Voltage (V)";
            texture: root.vbus-texture;
            y-min: root.vbus-y-min;
            y-max: root.vbus-y-max;
            y-divisions: 3;
            time-window: 2.0;
            x-divisions: 5;
            sample-rate: 10.0;
            legend-labels: ["VBUS"];
            legend-colors: [#eab308];
        }

        temp-plot := PlotWidget {
            vertical-stretch: 1;
            title: "FET Temperature (°C)";
            texture: root.temp-texture;
            y-min: root.temp-y-min;
            y-max: root.temp-y-max;
            y-divisions: 3;
            time-window: 2.0;
            x-divisions: 5;
            sample-rate: 10.0;
            legend-labels: ["FET"];
            legend-colors: [#ef4444];
        }

        // ── Log panel ──
        Rectangle {
            property <bool> is-dark: Palette.color-scheme == ColorScheme.dark;
            vertical-stretch: 1;
            background: is-dark ? #1e1e2e : #f5f5f5;
            border-radius: 4px;
            min-height: 120px;

            VerticalLayout {
                spacing: 0px;

                // Header
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    Text {
                        text: "Log";
                        color: Palette.foreground;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Clear";
                        clicked => { root.clear-log(); }
                    }
                }

                // Log messages
                log-view := ListView {
                    for msg[index] in root.log-messages: Rectangle {
                        height: msg-text.preferred-height + 4px;

                        msg-text := Text {
                            text: msg.text;
                            color: msg.level == 4 ? (is-dark ? #f38ba8 : #d32f2f)
                                 : msg.level == 3 ? (is-dark ? #f9e2af : #e65100)
                                 : msg.level == 2 ? (is-dark ? #a6e3a1 : #2e7d32)
                                 : msg.level == 1 ? (is-dark ? #89b4fa : #1565c0)
                                 : (is-dark ? #6c7086 : #9e9e9e);
                            font-family: "monospace";
                            font-size: 11px;
                            x: 8px;
                            width: parent.width - 16px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }

                // Auto-scroll when new messages arrive
                property <int> scroll-trigger: root.log-messages.length;
                changed scroll-trigger => {
                    log-view.viewport-y = -100000px;
                }
            }
        }
    }
}
