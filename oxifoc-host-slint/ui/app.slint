import { VerticalBox, HorizontalBox, Button, ComboBox, Slider, CheckBox, SpinBox, TabWidget,
         StandardListView, LineEdit, GroupBox, ScrollView, GridBox, ListView, Palette } from "std-widgets.slint";
import { PlotWidget } from "@slint-wgpu-plot/plot.slint";

export struct LogMessage {
    text: string,
    level: int, // 0=trace, 1=debug, 2=info, 3=warn, 4=error
}

export struct FaultRow {
    category: string,
    severity: string,   // "Warning" / "GracefulStop" / "Kill"
    details: string,
    category-id: int,   // FaultCategory discriminant, for per-row clear
}

component TelemetryValue inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.foreground;
    min-width: 88px;
    min-height: 36px;
    VerticalLayout {
        spacing: 1px;
        Text { text: root.label; font-size: 10px; color: Palette.foreground.transparentize(0.42); }
        Text { text: root.value; font-size: 15px; font-weight: 600; color: root.value-color; overflow: elide; }
    }
}

export component App inherits Window {
    title: "Oxifoc Host";
    preferred-width: 1120px;
    preferred-height: 820px;
    property <bool> is-dark: Palette.background.to-hsv().value < 0.5;
    property <color> panel-color: is-dark ? #202b38 : #ffffff;
    property <color> canvas-color: is-dark ? #151d27 : #edf2f7;
    property <color> panel-border: is-dark ? #384757 : #d8e2ec;
    property <color> muted-text: Palette.foreground.transparentize(0.42);
    background: canvas-color;

    // ── Page state ──
    in-out property <string> page: "connect";

    // ── Connection properties ──
    // transport-mode: 0=Serial, 1=RTT, 2=TCP, 3=UDP, 4=USB
    in-out property <int> transport-mode: 0;
    in property <[StandardListViewItem]> serial-ports;
    in property <[StandardListViewItem]> probes;
    in-out property <int> selected-serial: -1;
    in-out property <int> selected-probe: -1;
    in-out property <int> baud-index: 3;
    in-out property <string> chip-name: "STM32G474RETx";
    in-out property <bool> usb-only: true;
    in-out property <string> tcp-host: "127.0.0.1";
    in-out property <string> tcp-port: "2025";
    in-out property <string> udp-host: "127.0.0.1";
    in-out property <string> udp-port: "2025";
    in property <[StandardListViewItem]> ble-devices;
    in-out property <int> selected-ble: -1;
    in-out property <bool> ble-scanning: false;
    in property <string> error-text: "";

    // ── Main page state ──
    in property <bool> is-connected: false;
    // 0=focus, 1=compare, 2=overview, 3=2x2.
    in-out property <int> chart-layout: 0;
    in-out property <int> primary-chart: 0;
    in-out property <int> secondary-chart: 3;
    property <int> return-layout: -1;
    in-out property <bool> show-ia: true;
    in-out property <bool> show-ib: true;
    in-out property <bool> show-ic: true;
    in-out property <bool> show-id: false;
    in-out property <bool> show-iq: false;

    function focus-chart(index: int) {
        if (self.chart-layout != 0) { self.return-layout = self.chart-layout; }
        self.primary-chart = index;
        self.chart-layout = 0;
    }

    function restore-chart-layout() {
        if (self.return-layout >= 1) {
            self.chart-layout = self.return-layout;
            self.return-layout = -1;
        }
    }

    pure function chart-slot(index: int) -> int {
        if (self.chart-layout == 0) { return index == self.primary-chart ? 0 : -1; }
        if (self.chart-layout == 1) {
            if (index == self.primary-chart) { return 0; }
            return index == self.secondary-chart ? 1 : -1;
        }
        if (self.chart-layout == 2) { return index == 3 ? -1 : index; }
        return index;
    }

    pure function chart-x(slot: int, canvas-width: length) -> length {
        if (self.chart-layout == 0 || slot == 0) { return 8px; }
        if (self.chart-layout == 1) { return canvas-width / 2 + 4px; }
        if (self.chart-layout == 2) { return canvas-width * 0.58 + 4px; }
        return Math.mod(slot, 2) == 0 ? 8px : canvas-width / 2 + 4px;
    }

    pure function chart-y(slot: int, canvas-height: length) -> length {
        if (self.chart-layout <= 1 || slot == 0) { return 8px; }
        if (self.chart-layout == 2) { return slot == 1 ? 8px : canvas-height / 2 + 4px; }
        return slot < 2 ? 8px : canvas-height / 2 + 4px;
    }

    pure function chart-width(slot: int, canvas-width: length) -> length {
        if (self.chart-layout == 0) { return canvas-width - 16px; }
        if (self.chart-layout == 2) { return slot == 0 ? canvas-width * 0.58 - 12px : canvas-width * 0.42 - 12px; }
        return (canvas-width - 24px) / 2;
    }

    pure function chart-height(slot: int, canvas-height: length) -> length {
        if (self.chart-layout <= 1) { return canvas-height - 16px; }
        if (self.chart-layout == 2) { return slot == 0 ? canvas-height - 16px : (canvas-height - 24px) / 2; }
        return (canvas-height - 24px) / 2;
    }

    // ── Device info (set once on connection) ──
    in property <string> device-hw: "";
    in property <string> device-sw: "";
    in property <string> device-mcu: "";
    in property <string> device-uuid: "";
    in property <int> device-foc-hz: 0;
    in property <float> device-max-current: 0;

    // ── Motor control ──
    in-out property <float> iq-target: 1.0;
    in-out property <string> id-target-text: "0";  // d-axis current (field weakening)
    in-out property <int> pole-pairs: 7;
    in-out property <int> active-tab: 0;
    in property <bool> motor-running: false;
    in property <bool> motor-command-pending: false;
    in property <string> motor-status: "";
    callback motor-update();  // called when slider changes while motor is running
    callback motor-coast();   // gates off, free spin
    callback motor-brake();   // short windings (parking brake)

    // Phase source (commutation angle source): requested via the combo,
    // active source read back from slow telemetry.
    in-out property <int> phase-source-index: 0;
    in property <string> phase-source-text: "";
    callback phase-source-changed();

    // ── Fast telemetry streaming ──
    in-out property <int> stream-rate-index: 0;  // default 100 Hz
    in property <bool> streaming: false;
    in property <string> rate-warning: "";
    callback stream-start();
    callback stream-stop();

    // ── Telemetry (formatted strings from Rust) ──
    in property <string> ia-text:   "0";
    in property <string> ib-text:   "0";
    in property <string> ic-text:   "0";
    in property <string> id-text:   "0";
    in property <string> iq-text:   "0";
    in property <string> vbus-text: "0.00 V";
    in property <string> temp-text: "0.0 °C";
    in property <string> erpm-text: "0";
    in property <string> rpm-text:  "0";
    in property <string> seq-text:  "0";
    in property <string> motor-state-text: "Stopped";
    in property <string> fault-text: "";

    // ── Chart textures and auto-range (set by Rust after each render) ──
    in property <image> currents-texture;
    in property <image> vbus-texture;
    in property <image> temp-texture;
    in property <image> hall-texture;
    in property <float> currents-y-min: -1.0;
    in property <float> currents-y-max: 1.0;
    in property <int> currents-y-divisions: 4;
    in property <float> vbus-y-min: 0.0;
    in property <float> vbus-y-max: 60.0;
    in property <int> vbus-y-divisions: 3;
    in property <float> temp-y-min: 0.0;
    in property <float> temp-y-max: 150.0;
    in property <int> temp-y-divisions: 3;
    in property <float> hall-y-min: 0.0;
    in property <float> hall-y-max: 7.0;
    in property <int> hall-y-divisions: 4;

    // ── Chart size feedback ──
    out property <int> currents-w: currents-plot.requested-texture-width / 1phx;
    out property <int> currents-h: currents-plot.requested-texture-height / 1phx;
    out property <int> vbus-w:     vbus-plot.requested-texture-width / 1phx;
    out property <int> vbus-h:     vbus-plot.requested-texture-height / 1phx;
    out property <int> temp-w:     temp-plot.requested-texture-width / 1phx;
    out property <int> temp-h:     temp-plot.requested-texture-height / 1phx;
    out property <int> hall-w:     hall-plot.requested-texture-width / 1phx;
    out property <int> hall-h:     hall-plot.requested-texture-height / 1phx;

    in property <int> currents-available: 0;
    in property <int> vbus-available: 0;
    in property <int> temp-available: 0;
    in property <int> hall-available: 0;
    // ── Chart pan/zoom state (read by Rust) ──
    out property <bool> currents-paused: currents-plot.paused;
    out property <int> currents-view-offset: currents-plot.effective-view-offset;
    out property <float> currents-time-window: currents-plot.visible-samples / currents-plot.sample-rate;
    out property <bool> vbus-paused: vbus-plot.paused;
    out property <int> vbus-view-offset: vbus-plot.effective-view-offset;
    out property <float> vbus-time-window: vbus-plot.visible-samples / vbus-plot.sample-rate;
    out property <bool> temp-paused: temp-plot.paused;
    out property <int> temp-view-offset: temp-plot.effective-view-offset;
    out property <float> temp-time-window: temp-plot.visible-samples / temp-plot.sample-rate;
    out property <bool> hall-paused: hall-plot.paused;
    out property <int> hall-view-offset: hall-plot.effective-view-offset;
    out property <float> hall-time-window: hall-plot.visible-samples / hall-plot.sample-rate;

    // ── Cursor measurements ──
    out property <bool> currents-cursor-active: currents-plot.cursor-active;
    out property <float> currents-cursor-frac: currents-plot.cursor-frac;
    in property <string> currents-cursor-text <=> currents-plot.cursor-text;
    out property <bool> vbus-cursor-active: vbus-plot.cursor-active;
    out property <float> vbus-cursor-frac: vbus-plot.cursor-frac;
    in property <string> vbus-cursor-text <=> vbus-plot.cursor-text;
    out property <bool> temp-cursor-active: temp-plot.cursor-active;
    out property <float> temp-cursor-frac: temp-plot.cursor-frac;
    in property <string> temp-cursor-text <=> temp-plot.cursor-text;
    out property <bool> hall-cursor-active: hall-plot.cursor-active;
    out property <float> hall-cursor-frac: hall-plot.cursor-frac;
    in property <string> hall-cursor-text <=> hall-plot.cursor-text;

    // ── Sample rate for plots (set by Rust from actual_fast_hz) ──
    in property <float> fast-sample-rate: 1000.0;

    // ── Log panel ──
    in property <[LogMessage]> log-messages;
    callback clear-log();

    // ── Motor presets ──
    in property <[string]> preset-names;
    in-out property <int> selected-preset: 0;
    callback preset-changed(string);

    // ── Config editor ──
    in-out property <int> config-group: 0;
    in property <string> config-status: "";
    // Motor params
    in-out property <string> cfg-resistance: "";
    in-out property <string> cfg-inductance-d: "";
    in-out property <string> cfg-inductance-q: "";
    in-out property <string> cfg-flux-linkage: "";
    in-out property <string> cfg-pole-pairs: "";
    in-out property <string> cfg-motor-rating: "";
    in-out property <string> cfg-motor-power-loss: "";
    // Current limits
    in-out property <string> cfg-max-iq: "";
    in-out property <string> cfg-max-phase-current: "";
    in-out property <string> cfg-bus-in-max: "";
    in-out property <string> cfg-bus-regen-max: "";
    // Voltage limits
    in-out property <string> cfg-min-vbus: "";
    in-out property <string> cfg-max-vbus: "";
    // PI gains
    in-out property <string> cfg-kp: "";
    in-out property <string> cfg-ki: "";
    in-out property <string> cfg-bandwidth: "";
    // Velocity loop
    in-out property <string> cfg-vel-kp: "";
    in-out property <string> cfg-vel-ki: "";
    in-out property <string> cfg-vel-accel: "";
    // Failsafe
    in-out property <string> cfg-fs-staleness: "";
    in-out property <string> cfg-fs-policy: "";
    in-out property <string> cfg-fs-brake-current: "";
    in-out property <string> cfg-fs-ramp: "";
    in-out property <string> cfg-fs-brake-time: "";
    in-out property <string> cfg-fs-standstill: "";
    in-out property <string> cfg-fs-decel: "";
    in-out property <string> cfg-fs-terminal: "";
    callback config-read();
    callback config-write();
    // Factory reset — guarded by an explicit confirm toggle (mirrors the
    // CLI's `--yes`).
    in-out property <bool> config-reset-confirm: false;
    callback config-reset();

    // ── Faults ──
    in property <[FaultRow]> faults;
    in property <int> fault-total: 0;
    callback faults-refresh();          // re-query the device
    callback clear-faults();            // clear all
    callback clear-fault-category(int); // clear one category by discriminant

    // ── Detection ──
    in property <string> detect-status: "";
    in property <string> detect-resistance: "";
    in property <string> detect-inductance-d: "";
    in property <string> detect-inductance-q: "";
    in property <string> detect-flux-linkage: "";
    in property <string> detect-kv: "";
    in property <string> detect-max-current: "";
    in property <string> detect-kp: "";
    in property <string> detect-ki: "";
    in-out property <string> detect-max-loss: "120";
    in-out property <string> detect-openloop-erpm: "700";
    in-out property <string> detect-sensorless-erpm: "4000";
    callback detect-start();
    callback detect-apply();

    // ── Callbacks ──
    callback refresh-serial-ports();
    callback refresh-probes();
    callback scan-ble();
    callback connect-device();
    callback disconnect-device();
    callback motor-start();
    callback motor-stop();

    // ═══════════════════════════════════════════
    //  Connection Page
    // ═══════════════════════════════════════════
    connect-page := Rectangle {
        visible: root.page == "connect";
        width: min(parent.width - 32px, 740px);
        height: min(parent.height - 32px,
            root.transport-mode == 0 || root.transport-mode == 1 || root.transport-mode == 5 ? 560px : 350px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.panel-color;
        border-width: 1px;
        border-color: root.panel-border;
        border-radius: 12px;

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            Text {
                text: "Connect to Oxifoc";
                font-size: 22px;
                font-weight: 700;
            }
            Text {
                text: "Choose a transport and select the controller.";
                font-size: 12px;
                color: root.muted-text;
            }

            // ── Transport selector ──
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Button {
                    text: "Serial";
                    primary: root.transport-mode == 0;
                    clicked => { root.transport-mode = 0; }
                }
                Button {
                    text: "RTT";
                    primary: root.transport-mode == 1;
                    clicked => { root.transport-mode = 1; }
                }
                Button {
                    text: "TCP";
                    primary: root.transport-mode == 2;
                    clicked => { root.transport-mode = 2; }
                }
                Button {
                    text: "UDP";
                    primary: root.transport-mode == 3;
                    clicked => { root.transport-mode = 3; }
                }
                Button {
                    text: "USB";
                    primary: root.transport-mode == 4;
                    clicked => { root.transport-mode = 4; }
                }
                Button {
                    text: "BLE";
                    primary: root.transport-mode == 5;
                    clicked => { root.transport-mode = 5; }
                }
            }

            if root.error-text != "" : Text {
                text: root.error-text;
                color: #ef4444;
                horizontal-alignment: center;
            }

            // ── Serial config ──
            if root.transport-mode == 0 : VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Serial Ports";
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    CheckBox {
                        text: "USB-Serial only";
                        checked <=> root.usb-only;
                        toggled => { root.refresh-serial-ports(); }
                    }
                    Button {
                        text: "Refresh";
                        clicked => { root.refresh-serial-ports(); }
                    }
                }

                Rectangle {
                    min-height: 160px;
                    vertical-stretch: 1;
                    StandardListView {
                        width: parent.width;
                        height: parent.height;
                        model: root.serial-ports;
                        current-item <=> root.selected-serial;
                    }
                    if root.serial-ports.length == 0 : Text {
                        text: "No serial ports found. For the virtual motor, choose TCP.";
                        x: 16px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 32px;
                        horizontal-alignment: center;
                        color: root.muted-text;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Baud Rate:"; vertical-alignment: center; }
                    ComboBox {
                        model: ["115200", "230400", "460800", "921600", "1000000", "2000000"];
                        current-index <=> root.baud-index;
                        width: 150px;
                    }
                }
            }

            // ── RTT config ──
            if root.transport-mode == 1 : VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Debug Probes";
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Refresh";
                        clicked => { root.refresh-probes(); }
                    }
                }

                Rectangle {
                    min-height: 160px;
                    vertical-stretch: 1;
                    StandardListView {
                        width: parent.width;
                        height: parent.height;
                        model: root.probes;
                        current-item <=> root.selected-probe;
                    }
                    if root.probes.length == 0 : Text {
                        text: "No debug probes found.";
                        x: 16px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 32px;
                        horizontal-alignment: center;
                        color: root.muted-text;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Target Chip:"; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.chip-name;
                        width: 220px;
                    }
                }
            }

            // ── TCP config ──
            if root.transport-mode == 2 : VerticalLayout {
                spacing: 8px;

                Text {
                    text: "TCP Connection";
                    font-size: 16px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Host:"; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.tcp-host;
                        width: 200px;
                    }
                    Text { text: "Port:"; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.tcp-port;
                        width: 80px;
                    }
                }
            }

            // ── UDP config ──
            if root.transport-mode == 3 : VerticalLayout {
                spacing: 8px;

                Text {
                    text: "UDP Connection";
                    font-size: 16px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Host:"; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.udp-host;
                        width: 200px;
                    }
                    Text { text: "Port:"; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.udp-port;
                        width: 80px;
                    }
                }
            }

            // ── USB config ──
            if root.transport-mode == 4 : VerticalLayout {
                spacing: 8px;

                Rectangle {
                    background: root.canvas-color;
                    border-radius: 8px;
                    min-height: 60px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: "USB (Auto-detect)";
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            color: Palette.foreground;
                        }
                        Text {
                            text: "Requires one unambiguous ergot USB device and pins it across reconnects";
                            horizontal-alignment: center;
                            color: root.muted-text;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ── BLE config ──
            if root.transport-mode == 5 : VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "BLE Devices";
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Button {
                        text: root.ble-scanning ? "Scanning..." : "Scan";
                        enabled: !root.ble-scanning;
                        clicked => { root.scan-ble(); }
                    }
                }

                Rectangle {
                    min-height: 200px;
                    vertical-stretch: 1;
                    StandardListView {
                        width: parent.width;
                        height: parent.height;
                        model: root.ble-devices;
                        current-item <=> root.selected-ble;
                    }
                    if root.ble-devices.length == 0 : Text {
                        text: root.ble-scanning ? "Scanning for devices…" : "No BLE devices found. Press Scan to search.";
                        x: 16px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 32px;
                        horizontal-alignment: center;
                        color: root.muted-text;
                    }
                }
            }

            // ── Connect button ──
            HorizontalLayout {
                alignment: center;

                Button {
                    text: "Connect";
                    primary: true;
                    enabled: root.transport-mode == 0 ? root.selected-serial >= 0
                           : root.transport-mode == 1 ? (root.selected-probe >= 0 && root.chip-name != "")
                           : root.transport-mode == 2 ? (root.tcp-host != "" && root.tcp-port != "")
                           : root.transport-mode == 3 ? (root.udp-host != "" && root.udp-port != "")
                           : root.transport-mode == 4 ? true // USB always enabled
                           : root.transport-mode == 5 ? root.selected-ble >= 0
                           : true;
                    clicked => { root.connect-device(); }
                }
            }
        } // end connection form
    }

    // ═══════════════════════════════════════════
    //  Main Page
    // ═══════════════════════════════════════════
    main-page := FocusScope {
        visible: root.page == "main";
        capture-key-pressed(event) => {
            if (event.text == Key.Escape && root.return-layout >= 1) {
                root.restore-chart-layout();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // The connection state and disconnect action stay visible on every tab.
        HorizontalLayout {
            min-height: 36px;
            spacing: 12px;
            cross-axis-alignment: center;
            Text { text: "Oxifoc"; font-size: 22px; font-weight: 700; vertical-alignment: center; }
            Rectangle { width: 1px; background: root.panel-border; }
            Rectangle { width: 9px; height: 9px; border-radius: 5px;
                background: root.is-connected ? #239e75 : #d39a20; }
            Text {
                text: root.is-connected ? (root.device-hw != "" ? root.device-hw : "Connected") : "Connecting…";
                font-size: 12px; font-weight: 600; vertical-alignment: center;
            }
            if root.device-sw != "" : Text {
                text: root.device-sw; font-size: 11px; color: root.muted-text; vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.fault-text != "" : Text {
                text: root.fault-text; color: #d94b4b; font-weight: 600; vertical-alignment: center;
            }
            Button { text: "Disconnect"; clicked => { root.disconnect-device(); } }
        }

        HorizontalLayout {
            spacing: 10px;
            min-height: 136px;

            // Command controls are grouped by what they operate.
            Rectangle {
                min-width: 366px;
                max-width: 410px;
                background: root.panel-color;
                border-width: 1px;
                border-color: root.panel-border;
                border-radius: 9px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text { text: "Motor control"; font-size: 14px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Iq"; width: 36px; vertical-alignment: center; }
                        Slider {
                            minimum: 0; maximum: root.device-max-current > 0 ? root.device-max-current : 20;
                            value <=> root.iq-target; min-width: 80px;
                            changed(val) => { if root.motor-running { root.motor-update(); } }
                        }
                        Text { text: "\{round(root.iq-target * 10) / 10} A"; min-width: 46px;
                            horizontal-alignment: right; vertical-alignment: center; font-weight: 600; }
                        Button { text: root.motor-command-pending && !root.motor-running ? "..." : "Start";
                            primary: !root.motor-running;
                            enabled: root.is-connected && !root.motor-running && !root.motor-command-pending;
                            clicked => { root.motor-start(); } }
                        Button { text: "STOP"; primary: root.motor-running; enabled: root.is-connected;
                            clicked => { root.motor-stop(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Id"; width: 36px; vertical-alignment: center; }
                        LineEdit { text <=> root.id-target-text; min-width: 64px; horizontal-alignment: right; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Coast"; enabled: root.is-connected; clicked => { root.motor-coast(); } }
                        Button { text: "Brake"; enabled: root.is-connected; clicked => { root.motor-brake(); } }
                    }
                    if root.motor-status != "" : Text {
                        text: root.motor-status; font-size: 11px; wrap: word-wrap;
                        color: root.motor-status == "OK" ? #239e75 : #bb7d11;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: root.panel-color;
                border-width: 1px;
                border-color: root.panel-border;
                border-radius: 9px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 5px;
                    HorizontalLayout {
                        Text { text: "Live telemetry"; font-size: 14px; font-weight: 700; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.motor-state-text; font-size: 12px; font-weight: 600;
                            color: root.motor-state-text == "Running" ? #239e75
                                 : root.motor-state-text == "Fault" ? #d94b4b : root.muted-text; }
                    }
                    GridLayout {
                        spacing: 3px;
                        Row {
                            TelemetryValue { label: "Phase A"; value: root.ia-text; }
                            TelemetryValue { label: "Phase B"; value: root.ib-text; }
                            TelemetryValue { label: "Phase C"; value: root.ic-text; }
                            TelemetryValue { label: "Id"; value: root.id-text; }
                            TelemetryValue { label: "Iq"; value: root.iq-text; }
                            TelemetryValue { label: "Bus voltage"; value: root.vbus-text; }
                        }
                        Row {
                            TelemetryValue { label: "Electrical RPM"; value: root.erpm-text; }
                            TelemetryValue { label: "RPM"; value: root.rpm-text; }
                            TelemetryValue { label: "FET temp"; value: root.temp-text; }
                            TelemetryValue { label: "Angle source"; value: root.phase-source-text != "" ? root.phase-source-text : "—"; }
                            TelemetryValue { label: "Sequence"; value: root.seq-text; }
                        }
                    }
                }
            }
        }

        // Stream setup and navigation are one compact band above the charts.
        Rectangle {
            min-height: 48px;
            background: root.panel-color;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 9px;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                Text { text: "Stream"; color: root.muted-text; vertical-alignment: center; }
                ComboBox {
                    model: ["100 Hz", "500 Hz", "1000 Hz", "2000 Hz", "5000 Hz", "10000 Hz", "20000 Hz"];
                    current-index <=> root.stream-rate-index;
                    min-width: 94px;
                }
                Button { text: root.streaming ? "Stop" : "Start"; primary: !root.streaming;
                    enabled: root.is-connected || root.streaming;
                    clicked => { if root.streaming { root.stream-stop(); } else { root.stream-start(); } } }
                Text { text: "Source"; color: root.muted-text; vertical-alignment: center; }
                ComboBox {
                    model: ["Hall", "Hall+Fallback", "Observer", "HFI", "HFI→Observer", "HFI→Obs (V)"];
                    current-index <=> root.phase-source-index;
                    min-width: 124px;
                    selected => { root.phase-source-changed(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Monitor"; primary: root.active-tab == 0; clicked => { root.active-tab = 0; } }
                Button { text: "Config"; primary: root.active-tab == 1; clicked => { root.active-tab = 1; } }
                Button { text: "Detect"; primary: root.active-tab == 2; clicked => { root.active-tab = 2; } }
                Button { text: "Faults"; primary: root.active-tab == 3;
                    clicked => { root.active-tab = 3; root.faults-refresh(); } }
                Button { text: "Log"; primary: root.active-tab == 4; clicked => { root.active-tab = 4; } }
            }
        }
        if root.rate-warning != "" : Text {
            text: root.rate-warning; color: #bb7d11; font-size: 11px;
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.panel-color;
            border-width: 1px;
            border-color: root.panel-border;
            border-radius: 9px;

            VerticalLayout {
                visible: root.active-tab == 0;
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text { text: "Plots"; font-size: 14px; font-weight: 700; }
                    ComboBox {
                        model: ["Focus", "Compare", "Overview", "2 × 2"];
                        current-index <=> root.chart-layout;
                        min-width: 116px;
                        max-width: 116px;
                    }
                    if root.chart-layout == 0 && root.return-layout >= 1 : Button {
                        text: "Back";
                        clicked => { root.restore-chart-layout(); }
                    }
                    if root.chart-layout <= 1 : ComboBox {
                        model: ["Currents", "Bus voltage", "FET temperature", "Angle / eRPM"];
                        current-index <=> root.primary-chart;
                        min-width: 170px;
                        max-width: 170px;
                        selected => {
                            if (root.primary-chart == root.secondary-chart) {
                                root.secondary-chart = Math.mod(root.primary-chart + 1, 4);
                            }
                        }
                    }
                    if root.chart-layout == 1 : ComboBox {
                        model: ["Currents", "Bus voltage", "FET temperature", "Angle / eRPM"];
                        current-index <=> root.secondary-chart;
                        min-width: 170px;
                        max-width: 170px;
                        selected => {
                            if (root.secondary-chart == root.primary-chart) {
                                root.primary-chart = Math.mod(root.secondary-chart + 1, 4);
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.chart-layout == 0 ? "One signal group" : root.chart-layout == 1 ? "Two groups"
                            : root.chart-layout == 2 ? "Currents · VBUS · FET" : "All groups";
                        color: root.muted-text;
                        font-size: 11px;
                    }
                }

                if root.chart-slot(0) >= 0 : HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Text { text: "Currents · A"; font-size: 11px; color: root.muted-text; }
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #22d3ee; }
                    CheckBox { text: "Ia"; checked <=> root.show-ia; }
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #8b5cf6; }
                    CheckBox { text: "Ib"; checked <=> root.show-ib; }
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f97316; }
                    CheckBox { text: "Ic"; checked <=> root.show-ic; }
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #24a759; }
                    CheckBox { text: "Id"; checked <=> root.show-id; }
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #ea4576; }
                    CheckBox { text: "Iq"; checked <=> root.show-iq; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Select traces to overlay"; font-size: 11px; color: root.muted-text; }
                }

                chart-canvas := Rectangle {
                    vertical-stretch: 1;
                    min-height: 300px;
                    clip: true;
                    background: root.panel-color;

                    currents-plot := PlotWidget {
                        property <int> slot: root.chart-slot(0);
                        visible: self.slot >= 0;
                        x: root.chart-x(self.slot, chart-canvas.width);
                        y: root.chart-y(self.slot, chart-canvas.height);
                        width: root.chart-width(self.slot, chart-canvas.width);
                        height: root.chart-height(self.slot, chart-canvas.height);
                        title: "Phase & dq currents (A)";
                        texture: root.currents-texture;
                        available-samples: root.currents-available;
                        y-min: root.currents-y-min;
                        y-max: root.currents-y-max;
                        y-divisions: root.currents-y-divisions;
                        time-window: 2.0;
                        x-divisions: 5;
                        sample-rate: root.fast-sample-rate;
                        focus-requested => { root.focus-chart(0); }
                    }
                    vbus-plot := PlotWidget {
                        property <int> slot: root.chart-slot(1);
                        visible: self.slot >= 0;
                        x: root.chart-x(self.slot, chart-canvas.width);
                        y: root.chart-y(self.slot, chart-canvas.height);
                        width: root.chart-width(self.slot, chart-canvas.width);
                        height: root.chart-height(self.slot, chart-canvas.height);
                        title: "Bus voltage (V)";
                        texture: root.vbus-texture;
                        available-samples: root.vbus-available;
                        y-min: root.vbus-y-min;
                        y-max: root.vbus-y-max;
                        y-divisions: root.vbus-y-divisions;
                        time-window: 2.0;
                        x-divisions: 4;
                        sample-rate: 10.0;
                        legend-labels: ["VBUS"];
                        legend-colors: [#eab308];
                        focus-requested => { root.focus-chart(1); }
                    }
                    temp-plot := PlotWidget {
                        property <int> slot: root.chart-slot(2);
                        visible: self.slot >= 0;
                        x: root.chart-x(self.slot, chart-canvas.width);
                        y: root.chart-y(self.slot, chart-canvas.height);
                        width: root.chart-width(self.slot, chart-canvas.width);
                        height: root.chart-height(self.slot, chart-canvas.height);
                        title: "FET temperature (°C)";
                        texture: root.temp-texture;
                        available-samples: root.temp-available;
                        y-min: root.temp-y-min;
                        y-max: root.temp-y-max;
                        y-divisions: root.temp-y-divisions;
                        time-window: 2.0;
                        x-divisions: 4;
                        sample-rate: 10.0;
                        legend-labels: ["FET"];
                        legend-colors: [#ef4444];
                        focus-requested => { root.focus-chart(2); }
                    }
                    hall-plot := PlotWidget {
                        property <int> slot: root.chart-slot(3);
                        visible: self.slot >= 0;
                        x: root.chart-x(self.slot, chart-canvas.width);
                        y: root.chart-y(self.slot, chart-canvas.height);
                        width: root.chart-width(self.slot, chart-canvas.width);
                        height: root.chart-height(self.slot, chart-canvas.height);
                        title: "Angle & eRPM";
                        texture: root.hall-texture;
                        available-samples: root.hall-available;
                        y-min: root.hall-y-min;
                        y-max: root.hall-y-max;
                        y-divisions: root.hall-y-divisions;
                        time-window: 2.0;
                        x-divisions: 5;
                        sample-rate: root.fast-sample-rate;
                        legend-labels: ["Angle (rad)", "eRPM (÷1000)"];
                        legend-colors: [#4ade80, #60a5fa];
                        focus-requested => { root.focus-chart(3); }
                    }
                }
            }

            // ── Config tab ──
            if root.active-tab == 1 : VerticalLayout {
                padding: 8px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Config group:"; vertical-alignment: center; }
                    ComboBox {
                        model: ["Motor Params", "Current Limits", "Voltage Limits", "PI Gains", "Velocity Loop", "Failsafe"];
                        current-index <=> root.config-group;
                        min-width: 160px;
                    }
                    Button { text: "Read"; clicked => { root.config-read(); } }
                    Button {
                        text: root.config-group == 2 ? "Read-only" : "Write";
                        primary: root.config-group != 2;
                        enabled: root.config-group != 2;
                        clicked => { root.config-write(); }
                    }
                    Rectangle { width: 16px; }
                    CheckBox { text: "confirm"; checked <=> root.config-reset-confirm; }
                    Button {
                        text: "Reset all";
                        enabled: root.config-reset-confirm;
                        clicked => { root.config-reset(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.config-status != "" : Text {
                        text: root.config-status;
                        vertical-alignment: center;
                        color: root.config-status == "OK" ? #22c55e : #eab308;
                        font-size: 11px;
                    }
                }

                if root.config-group == 0 : GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Resistance (Ω):"; } LineEdit { text <=> root.cfg-resistance; min-width: 120px; }
                        Text { text: "Inductance D (H):"; } LineEdit { text <=> root.cfg-inductance-d; min-width: 120px; }
                    }
                    Row {
                        Text { text: "Inductance Q (H):"; } LineEdit { text <=> root.cfg-inductance-q; min-width: 120px; }
                        Text { text: "Flux linkage (Wb):"; } LineEdit { text <=> root.cfg-flux-linkage; min-width: 120px; }
                    }
                    Row { Text { text: "Pole pairs:"; } LineEdit { text <=> root.cfg-pole-pairs; min-width: 120px; } }
                    Row { Text { text: "Rating (A, 0=unknown):"; } LineEdit { text <=> root.cfg-motor-rating; min-width: 120px; } }
                    Row { Text { text: "Power class (W):"; } LineEdit { text <=> root.cfg-motor-power-loss; min-width: 120px; } }
                }
                if root.config-group == 1 : GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Max Iq (A):"; } LineEdit { text <=> root.cfg-max-iq; min-width: 120px; }
                        Text { text: "Max phase current (A):"; } LineEdit { text <=> root.cfg-max-phase-current; min-width: 120px; }
                    }
                    Row {
                        Text { text: "Bus in max (A, <0 = off):"; } LineEdit { text <=> root.cfg-bus-in-max; min-width: 120px; }
                        Text { text: "Bus regen max (A, 0 = none):"; } LineEdit { text <=> root.cfg-bus-regen-max; min-width: 120px; }
                    }
                }
                if root.config-group == 2 : GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Min VBUS (mV):"; } LineEdit { text <=> root.cfg-min-vbus; min-width: 120px; }
                        Text { text: "Max VBUS (mV):"; } LineEdit { text <=> root.cfg-max-vbus; min-width: 120px; }
                    }
                }
                if root.config-group == 2 : Text {
                    text: "Voltage limits are stored for inspection only; this firmware does not apply runtime writes.";
                    color: Palette.foreground.transparentize(0.4);
                    font-size: 11px;
                }
                if root.config-group == 3 : GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Kp:"; } LineEdit { text <=> root.cfg-kp; min-width: 120px; }
                        Text { text: "Ki:"; } LineEdit { text <=> root.cfg-ki; min-width: 120px; }
                    }
                    Row { Text { text: "Bandwidth (rad/s):"; } LineEdit { text <=> root.cfg-bandwidth; min-width: 120px; } }
                }
                if root.config-group == 4 : GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Kp (A per rad/s):"; } LineEdit { text <=> root.cfg-vel-kp; min-width: 120px; }
                        Text { text: "Ki (A per rad):"; } LineEdit { text <=> root.cfg-vel-ki; min-width: 120px; }
                    }
                    Row { Text { text: "Accel limit (erad/s²):"; } LineEdit { text <=> root.cfg-vel-accel; min-width: 120px; } }
                }
                if root.config-group == 5 : GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Staleness (ms):"; } LineEdit { text <=> root.cfg-fs-staleness; min-width: 120px; }
                        Text { text: "Policy (0=coast 1=ramp 2=stop):"; } LineEdit { text <=> root.cfg-fs-policy; min-width: 120px; }
                    }
                    Row {
                        Text { text: "Brake current (A):"; } LineEdit { text <=> root.cfg-fs-brake-current; min-width: 120px; }
                        Text { text: "Ramp (ms):"; } LineEdit { text <=> root.cfg-fs-ramp; min-width: 120px; }
                    }
                    Row {
                        Text { text: "Brake time cap (ms):"; } LineEdit { text <=> root.cfg-fs-brake-time; min-width: 120px; }
                        Text { text: "Standstill (erad/s):"; } LineEdit { text <=> root.cfg-fs-standstill; min-width: 120px; }
                    }
                    Row {
                        Text { text: "Decel (erad/s²):"; } LineEdit { text <=> root.cfg-fs-decel; min-width: 120px; }
                        Text { text: "Terminal (0=high-Z 1=brake):"; } LineEdit { text <=> root.cfg-fs-terminal; min-width: 120px; }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ── Detection tab ──
            if root.active-tab == 2 : VerticalLayout {
                padding: 8px;
                spacing: 8px;

                // Motor preset + pole pairs (moved here from top level)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Motor:"; vertical-alignment: center; }
                    ComboBox {
                        model: root.preset-names;
                        current-index <=> root.selected-preset;
                        selected(idx) => { root.preset-changed(idx); }
                        min-width: 200px;
                    }
                    Text { text: "Pole pairs:"; vertical-alignment: center; }
                    SpinBox { minimum: 1; maximum: 50; value <=> root.pole-pairs; min-width: 80px; }
                }

                GridLayout {
                    spacing: 6px;
                    Row {
                        Text { text: "Max power loss (W):"; } LineEdit { text <=> root.detect-max-loss; min-width: 100px; }
                        Text { text: "Open-loop ERPM:"; } LineEdit { text <=> root.detect-openloop-erpm; min-width: 100px; }
                    }
                    Row {
                        Text { text: "Sensorless ERPM:"; } LineEdit { text <=> root.detect-sensorless-erpm; min-width: 100px; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Button { text: "Start Detection"; primary: true; clicked => { root.detect-start(); } }
                    if root.detect-resistance != "" : Button { text: "Apply to Config"; clicked => { root.detect-apply(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.detect-status != "" : Text {
                        text: root.detect-status;
                        vertical-alignment: center;
                        color: root.detect-status == "OK" ? #22c55e
                            : root.detect-status == "Running..." ? #eab308
                            : #ef4444;
                        font-size: 11px;
                    }
                }

                if root.detect-resistance != "" : Rectangle {
                    background: Palette.alternate-background;
                    border-radius: 4px;
                    GridLayout {
                        padding: 10px;
                        spacing: 6px;
                        Row {
                            Text { text: "Resistance (Ω):"; } Text { text: root.detect-resistance; font-weight: 600; }
                            Text { text: "Inductance D (H):"; } Text { text: root.detect-inductance-d; font-weight: 600; }
                        }
                        Row {
                            Text { text: "Inductance Q (H):"; } Text { text: root.detect-inductance-q; font-weight: 600; }
                            Text { text: "Flux linkage (Wb):"; } Text { text: root.detect-flux-linkage; font-weight: 600; }
                        }
                        Row {
                            Text { text: "Kv (RPM/V):"; } Text { text: root.detect-kv; font-weight: 600; }
                            Text { text: "Max current (A):"; } Text { text: root.detect-max-current; font-weight: 600; }
                        }
                        Row {
                            Text { text: "Kp:"; } Text { text: root.detect-kp; font-weight: 600; }
                            Text { text: "Ki:"; } Text { text: root.detect-ki; font-weight: 600; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ── Faults tab ──
            if root.active-tab == 3 : VerticalLayout {
                padding: 8px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Active faults: \{root.fault-total}";
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: root.fault-total > 0 ? #ef4444 : #22c55e;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Refresh"; clicked => { root.faults-refresh(); } }
                    Button {
                        text: "Clear All";
                        enabled: root.fault-total > 0;
                        clicked => { root.clear-faults(); }
                    }
                }

                if root.faults.length == 0 : Text {
                    text: "No active faults.";
                    color: #22c55e;
                    font-size: 12px;
                }

                ListView {
                    vertical-stretch: 1;
                    for f[idx] in root.faults : Rectangle {
                        height: max(44px, details-text.preferred-height + 12px);
                        background: Palette.alternate-background;
                        border-radius: 4px;

                        fault-row := HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;

                            Text {
                                text: f.severity;
                                width: 100px;
                                font-weight: 600;
                                font-size: 11px;
                                vertical-alignment: center;
                                color: f.severity == "Kill" ? #ef4444
                                     : f.severity == "GracefulStop" ? #eab308
                                     : #4ade80;
                            }
                            Text {
                                text: f.category;
                                width: 120px;
                                font-weight: 600;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            details-text := Text {
                                text: f.details;
                                horizontal-stretch: 1;
                                font-size: 11px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Clear";
                                clicked => { root.clear-fault-category(f.category-id); }
                            }
                        }
                    }
                }
            }

            // ── Log tab ──
            if root.active-tab == 4 : VerticalLayout {

                property <bool> is-dark: Palette.color-scheme == ColorScheme.dark;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    Text { text: "Log"; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Clear"; clicked => { root.clear-log(); } }
                }

                log-view := ListView {
                    for msg[index] in root.log-messages: Rectangle {
                        height: msg-text.preferred-height + 4px;

                        msg-text := Text {
                            text: msg.text;
                            color: msg.level == 4 ? (is-dark ? #f38ba8 : #d32f2f)
                                 : msg.level == 3 ? (is-dark ? #f9e2af : #e65100)
                                 : msg.level == 2 ? (is-dark ? #a6e3a1 : #2e7d32)
                                 : msg.level == 1 ? (is-dark ? #89b4fa : #1565c0)
                                 : (is-dark ? #6c7086 : #9e9e9e);
                            font-family: "monospace";
                            font-size: 11px;
                            x: 8px;
                            width: parent.width - 16px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }

                property <int> scroll-trigger: root.log-messages.length;
                changed scroll-trigger => {
                    log-view.content-y = -100000px;
                }
            }

        } // end content Rectangle
        } // end main page layout
    } // end main-page
}
