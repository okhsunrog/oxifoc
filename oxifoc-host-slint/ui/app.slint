import { VerticalBox, HorizontalBox, Button, ComboBox, Slider, CheckBox,
         StandardListView, LineEdit, GroupBox, ScrollView, GridBox } from "std-widgets.slint";
import { PlotWidget } from "@slint-wgpu-plot/plot.slint";

export component App inherits Window {
    title: "Oxifoc Host";
    preferred-width: 900px;
    preferred-height: 750px;

    // ── Page state ──
    in-out property <string> page: "connect";

    // ── Connection properties ──
    in-out property <bool> use-serial: true;
    in-out property <bool> use-simulate: false;
    in property <[StandardListViewItem]> serial-ports;
    in property <[StandardListViewItem]> probes;
    in-out property <int> selected-serial: -1;
    in-out property <int> selected-probe: -1;
    in-out property <int> baud-index: 3;
    in-out property <string> chip-name: "STM32G474RETx";
    in-out property <bool> usb-only: true;
    in property <string> error-text: "";

    // ── Main page state ──
    in property <bool> is-connected: false;

    // ── Motor control ──
    in-out property <float> duty: 10;

    // ── Telemetry (formatted strings from Rust) ──
    in property <string> ia-text:   "0";
    in property <string> ib-text:   "0";
    in property <string> ic-text:   "0";
    in property <string> vbus-text: "0.00 V";
    in property <string> temp-text: "0.0 °C";
    in property <string> seq-text:  "0";

    // ── Chart textures (set by Rust after each render) ──
    in property <image> currents-texture;
    in property <image> vbus-texture;
    in property <image> temp-texture;

    // ── Chart size feedback (read by Rust in BeforeRendering).
    //    Elements live in main-page which is always in the tree (just hidden);
    //    this lets us bind to their properties unconditionally. ──
    out property <length> currents-w: currents-plot.requested-texture-width;
    out property <length> currents-h: currents-plot.requested-texture-height;
    out property <length> vbus-w:     vbus-plot.requested-texture-width;
    out property <length> vbus-h:     vbus-plot.requested-texture-height;
    out property <length> temp-w:     temp-plot.requested-texture-width;
    out property <length> temp-h:     temp-plot.requested-texture-height;

    // ── Callbacks ──
    callback refresh-serial-ports();
    callback refresh-probes();
    callback connect-device();
    callback disconnect-device();
    callback motor-start();
    callback motor-stop();

    // ═══════════════════════════════════════════
    //  Connection Page  (hidden, not destroyed, when on main page)
    // ═══════════════════════════════════════════
    connect-page := VerticalLayout {
        visible: root.page == "connect";
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "Connect to Device";
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Button {
                text: (!root.use-simulate && root.use-serial) ? "● Serial (UART)" : "○ Serial (UART)";
                clicked => { root.use-serial = true; root.use-simulate = false; }
            }
            Button {
                text: (!root.use-simulate && !root.use-serial) ? "● RTT (Debug Probe)" : "○ RTT (Debug Probe)";
                clicked => { root.use-serial = false; root.use-simulate = false; }
            }
            Button {
                text: root.use-simulate ? "● Simulate" : "○ Simulate";
                clicked => { root.use-simulate = true; }
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: #ef4444;
            horizontal-alignment: center;
        }

        if root.use-simulate : VerticalLayout {
            spacing: 8px;

            Rectangle {
                background: #f0f0f5;
                border-radius: 4px;
                min-height: 80px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Built-in PMSM model";
                        font-size: 15px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "R = 0.5 Ω  ·  L = 0.5 mH  ·  λ = 10 mWb  ·  7 pole pairs  ·  J = 0.1 g·m²";
                        horizontal-alignment: center;
                        color: #555;
                    }
                    Text {
                        text: "Vbus = 24 V  ·  FOC at 20 kHz  ·  No load torque";
                        horizontal-alignment: center;
                        color: #555;
                    }
                }
            }
        }

        if !root.use-simulate && root.use-serial : VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Serial Ports";
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                CheckBox {
                    text: "USB-Serial only";
                    checked <=> root.usb-only;
                    toggled => { root.refresh-serial-ports(); }
                }
                Button {
                    text: "Refresh";
                    clicked => { root.refresh-serial-ports(); }
                }
            }

            StandardListView {
                model: root.serial-ports;
                current-item <=> root.selected-serial;
                min-height: 160px;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text { text: "Baud Rate:"; vertical-alignment: center; }
                ComboBox {
                    model: ["115200", "230400", "460800", "921600", "1000000", "2000000"];
                    current-index <=> root.baud-index;
                    width: 150px;
                }
            }
        }

        if !root.use-simulate && !root.use-serial : VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Debug Probes";
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Button {
                    text: "Refresh";
                    clicked => { root.refresh-probes(); }
                }
            }

            StandardListView {
                model: root.probes;
                current-item <=> root.selected-probe;
                min-height: 160px;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text { text: "Target Chip:"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.chip-name;
                    width: 220px;
                }
            }
        }

        HorizontalLayout {
            alignment: center;

            Button {
                text: "Connect";
                primary: true;
                enabled: root.use-simulate
                    ? true
                    : (root.use-serial
                        ? root.selected-serial >= 0
                        : (root.selected-probe >= 0 && root.chip-name != ""));
                clicked => { root.connect-device(); }
            }
        }
    }

    // ═══════════════════════════════════════════
    //  Main Page  (hidden, not destroyed, when on connect page)
    // ═══════════════════════════════════════════
    main-page := VerticalLayout {
        visible: root.page == "main";
        padding: 12px;
        spacing: 8px;

        // ── Status bar ──
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.is-connected ? #22c55e : #eab308;
            }
            Text {
                text: root.is-connected ? "Connected" : "Connecting...";
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Disconnect";
                clicked => { root.disconnect-device(); }
            }
        }

        // ── Motor control ──
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text { text: "Duty (%)"; vertical-alignment: center; }
            Slider {
                minimum: 0;
                maximum: 100;
                value <=> root.duty;
                min-width: 200px;
            }
            Text {
                text: "\{round(root.duty)}%";
                vertical-alignment: center;
                min-width: 45px;
            }
            Button {
                text: "Start";
                primary: true;
                clicked => { root.motor-start(); }
            }
            Button {
                text: "Stop";
                clicked => { root.motor-stop(); }
            }
        }

        // ── Telemetry ──
        Rectangle {
            background: #f0f0f5;
            border-radius: 4px;
            min-height: 60px;

            GridLayout {
                padding: 10px;
                spacing: 6px;

                Row {
                    Text { text: "Phase A:"; }
                    Text { text: root.ia-text;   font-weight: 600; }
                    Text { text: "Phase B:"; }
                    Text { text: root.ib-text;   font-weight: 600; }
                    Text { text: "Phase C:"; }
                    Text { text: root.ic-text;   font-weight: 600; }
                }
                Row {
                    Text { text: "VBUS:"; }
                    Text { text: root.vbus-text; font-weight: 600; }
                    Text { text: "Temp:"; }
                    Text { text: root.temp-text; font-weight: 600; }
                    Text { text: "Seq:"; }
                    Text { text: root.seq-text;  font-weight: 600; }
                }
            }
        }

        // ── Charts ──
        currents-plot := PlotWidget {
            vertical-stretch: 2;
            title: "Phase Currents (ADC counts)";
            texture: root.currents-texture;
        }

        vbus-plot := PlotWidget {
            vertical-stretch: 1;
            title: "Bus Voltage (V)";
            texture: root.vbus-texture;
        }

        temp-plot := PlotWidget {
            vertical-stretch: 1;
            title: "FET Temperature (°C)";
            texture: root.temp-texture;
        }
    }
}
