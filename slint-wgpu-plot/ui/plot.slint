// PlotWidget — a GPU-accelerated real-time line chart for Slint.
//
// The Rust side renders into `texture` via `PlotRenderer::render()`.
// The widget feeds back the pixel dimensions the renderer should target
// through `requested-texture-width` / `requested-texture-height`.
//
// Supports mouse interaction:
// - Scroll wheel: zoom in/out (changes visible-samples via time-window)
// - Click + drag: pan horizontally (when paused)
// - Double-click: toggle pause/resume

import { Palette } from "std-widgets.slint";

export component PlotWidget inherits Rectangle {
    // Set by Rust after each `PlotRenderer::render()` call.
    in property <image> texture;

    // Read by Rust in `BeforeRendering` to know what size texture to produce.
    out property <length> requested-texture-width:  plot-area.width;
    out property <length> requested-texture-height: plot-area.height;

    // Chart title shown above the plot area.
    in property <string> title: "";

    // Y-axis range (must match PlotConfig y_min/y_max)
    in property <float> y-min: -1.0;
    in property <float> y-max: 1.0;

    // Time window in seconds (for X-axis labels)
    in-out property <float> time-window: 2.0;

    // Number of Y divisions (creates N+1 labels, N-1 interior grid lines)
    in property <int> y-divisions: 4;

    // Number of X divisions
    in property <int> x-divisions: 5;

    // Legend entries: ["Phase A", "Phase B", "Phase C"]
    in property <[string]> legend-labels: [];

    // Legend colors (ARGB hex): must match channel_colors order
    in property <[color]> legend-colors: [];

    // Pan/zoom state (read by Rust for rendering)
    in-out property <bool> paused: false;
    // View offset in samples (how far back from live to look when paused)
    in-out property <int> view-offset: 0;
    // Sample rate in Hz (needed to convert pixel drag to sample offset)
    in property <float> sample-rate: 1000.0;

    // Theme-aware colors
    property <bool> is-dark: Palette.color-scheme == ColorScheme.dark;
    property <color> plot-bg: is-dark ? #0f0f1e : #fafafa;
    property <color> grid-color: is-dark ? #1a1a30 : #e0e0e0;
    property <color> axis-color: is-dark ? #5555aa : #909090;
    property <color> label-color: is-dark ? #8888bb : #606060;
    property <color> title-color: is-dark ? #ccccdd : #333333;
    property <color> plot-border-color: is-dark ? #333366 : #cccccc;
    property <color> paused-border-color: is-dark ? #aa5555 : #cc4444;

    // Layout dimensions
    property <length> y-label-width: 50px;
    property <length> x-label-height: 18px;
    property <length> title-height: title != "" ? 20px : 0px;
    property <length> legend-height: legend-labels.length > 0 ? 18px : 0px;

    background: transparent;
    min-height: 80px;

    VerticalLayout {
        padding: 4px;
        spacing: 0px;

        // Title
        if root.title != "" : HorizontalLayout {
            height: root.title-height;
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: root.title-color;
                horizontal-alignment: left;
            }
            if root.paused : Text {
                text: " [PAUSED]";
                font-size: 11px;
                font-weight: 600;
                color: root.paused-border-color;
            }
        }

        // Main plot area with Y-axis labels and X-axis below
        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Y-axis + plot area row
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Y-axis labels column
                Rectangle {
                    width: root.y-label-width;
                    clip: true;

                    for i in (root.y-divisions + 1): Text {
                        property <float> y-val: root.y-max - i * (root.y-max - root.y-min) / root.y-divisions;
                        property <float> y-frac: i / root.y-divisions;
                        x: 0;
                        y: y-frac <= 0.0 ? 0px
                         : y-frac >= 1.0 ? parent.height - self.height
                         : y-frac * parent.height - self.height / 2;
                        width: root.y-label-width - 4px;
                        horizontal-alignment: right;
                        text: abs(self.y-val) >= 10.0 ? "\{Math.round(self.y-val)}"
                            : abs(self.y-val) < 0.01 ? "0"
                            : "\{Math.round(self.y-val * 100) / 100}";
                        font-size: 10px;
                        color: root.label-color;
                    }
                }

                // Plot area
                plot-area := Rectangle {
                    horizontal-stretch: 1;
                    background: root.plot-bg;
                    border-width: root.paused ? 2px : 1px;
                    border-color: root.paused ? root.paused-border-color : root.plot-border-color;
                    clip: true;

                    // Vertical grid lines
                    for i in (root.x-divisions - 1): Rectangle {
                        x: (i + 1) * (parent.width / root.x-divisions);
                        y: 0;
                        width: 1px;
                        height: parent.height;
                        background: root.grid-color;
                    }

                    // Horizontal grid lines
                    for i in (root.y-divisions - 1): Rectangle {
                        x: 0;
                        y: (i + 1) * (parent.height / root.y-divisions);
                        width: parent.width;
                        height: 1px;
                        background: root.grid-color;
                    }

                    // Zero line (if within range)
                    if root.y-min < 0.0 && root.y-max > 0.0 : Rectangle {
                        property <float> zero-frac: root.y-max / (root.y-max - root.y-min);
                        x: 0;
                        y: self.zero-frac * parent.height - 0.5px;
                        width: parent.width;
                        height: 1px;
                        background: root.axis-color;
                    }

                    // Waveform texture
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.texture;
                        image-fit: fill;
                    }

                    // Mouse interaction overlay
                    touch := TouchArea {
                        width: parent.width;
                        height: parent.height;

                        property <float> drag-start-offset;

                        // Double-click: toggle pause
                        double-clicked => {
                            root.paused = !root.paused;
                            if (!root.paused) {
                                root.view-offset = 0;
                            }
                        }

                        // Drag start: save current offset (pan only works when paused)
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                self.drag-start-offset = root.view-offset;
                            }
                        }

                        // Drag: pan horizontally
                        moved => {
                            if (self.pressed && root.paused) {
                                // Convert pixel delta to sample offset
                                // pixels dragged * (samples_in_view / plot_width)
                                let dx-px = (self.mouse-x - self.pressed-x) / 1px;
                                let samples-in-view = root.time-window * root.sample-rate;
                                let samples-per-pixel = samples-in-view / (parent.width / 1px);
                                let delta-samples = dx-px * samples-per-pixel;
                                root.view-offset = max(0, round(self.drag-start-offset + delta-samples));
                            }
                        }

                        // Scroll wheel: zoom toward cursor position
                        scroll-event(event) => {
                            let factor = 1.0 - (event.delta-y / 1px) / 200.0;
                            let old-window = root.time-window;
                            let new-window = clamp(old-window * factor, 0.001, 10.0);

                            // Fraction of plot width where cursor is (0=left, 1=right)
                            let fx = clamp(self.mouse-x / parent.width, 0.0, 1.0);

                            // Samples under cursor before and after zoom
                            let old-vis = old-window * root.sample-rate;
                            let new-vis = new-window * root.sample-rate;

                            // Shift view-offset so the sample under cursor stays put
                            // Cursor is at (1-fx) from the right edge (live edge)
                            let shift = round((1.0 - fx) * (old-vis - new-vis));
                            root.view-offset = max(0, root.view-offset + shift);

                            root.time-window = new-window;
                            return accept;
                        }
                    }

                    // Legend overlay (bottom-right)
                    if root.legend-labels.length > 0 : Rectangle {
                        x: parent.width - self.width - 8px;
                        y: parent.height - self.height - 8px;
                        width: legend-layout.preferred-width + 16px;
                        height: legend-layout.preferred-height + 8px;
                        background: root.is-dark ? #0f0f1ecc : #fafafacc;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.grid-color;

                        legend-layout := VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            for label[i] in root.legend-labels: HorizontalLayout {
                                spacing: 6px;
                                height: 14px;

                                Rectangle {
                                    width: 12px;
                                    height: 3px;
                                    y: (parent.height - self.height) / 2;
                                    background: i < root.legend-colors.length ? root.legend-colors[i] : #ffffff;
                                    border-radius: 1px;
                                }
                                Text {
                                    text: label;
                                    font-size: 10px;
                                    color: root.label-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // X-axis labels row (spans full width, indented by y-label-width)
            HorizontalLayout {
                spacing: 0px;
                height: root.x-label-height;

                // Empty spacer matching Y-axis column width
                Rectangle { width: root.y-label-width; }

                // X-axis labels
                Rectangle {
                    horizontal-stretch: 1;

                    for i in (root.x-divisions + 1): Text {
                        property <float> offset-time: root.view-offset / root.sample-rate;
                        property <float> abs-time: Math.round((root.time-window * (root.x-divisions - i) / root.x-divisions + offset-time) * 1000) / 1000;
                        x: i * (parent.width / root.x-divisions) - self.width / 2;
                        y: 1px;
                        text: self.abs-time == 0 ? "0s"
                            : self.abs-time < 0.01 ? "-\{Math.round(self.abs-time * 10000) / 10}ms"
                            : self.abs-time < 1.0 ? "-\{Math.round(self.abs-time * 1000)}ms"
                            : "-\{Math.round(self.abs-time * 10) / 10}s";
                        font-size: 10px;
                        color: root.label-color;
                    }
                }
            }
        }
    }
}
