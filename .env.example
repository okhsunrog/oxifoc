# Bench hardware selectors for the justfile and scripts/. Copy to .env (not
# committed) and fill in the values for your bench. Every variable is
# optional while only one of each device is attached.

# probe-rs selector of the STM32 debug probe, VID:PID:serial
# (list with `probe-rs list`).
OXIFOC_MK5_PROBE=
# probe-rs selector of the ESP32-C5 USB Serial/JTAG on the bridge.
OXIFOC_C5_PROBE=
# Serial port of the C5 bridge, e.g. /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_<MAC>-if00.
OXIFOC_BRIDGE_SERIAL=
# Checkout of the C5 SPI probe firmware used by bench-mk5-bridge-spi.
OXIFOC_C5_PROJECT=

# Optional build-time credentials for wireless SWD. Keep `.env` and any
# firmware built with credentials private.
OXIFOC_PROBE_WIFI_SSID=
OXIFOC_PROBE_WIFI_PASSWORD=

# A per-bridge 32-byte key in hexadecimal. Generate with openssl rand -hex 32.
# Set for the bridge build and for the host CLI using OTA or wireless SWD arming.
OXIFOC_BRIDGE_OTA_KEY=
