# Auto-normalize line endings
* text=auto eol=lf

# Explicitly declare files that should always use LF
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.rs text eol=lf
*.toml text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
